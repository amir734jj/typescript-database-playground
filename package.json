{
  "name": "sqlite-playground",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "dist/nest/app.js",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "lint": "eslint . --ext .ts,.mjs,.cjs",
    "lint:fix": "eslint . --ext .ts,.mjs,.cjs --fix",
    "dev": "npm run build && node dist/nest/app.js",
    "start": "node dist/nest/app.js",
    "api:dev": "npm run dev",
    "api:start": "npm start",
    "db:up": "tsx src/tools/migration/migration-cli.ts up",
    "db:down": "tsx src/tools/migration/migration-cli.ts down"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cls-hooked": "^4.2.2",
    "dotenv": "18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "sqlite3": "^5.1.7",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/cls-hooked": "^4.3.9",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.20",
    "@types/luxon": "^3.7.1",
    "@types/node": "^26.6.6",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true
}
