{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["src"]
}